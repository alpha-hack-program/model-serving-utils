# Generated by KFP.
# Updated manually to include shared directory

ARG BASE_IMAGE

FROM ${BASE_IMAGE}

ARG COMPONENT_NAME

WORKDIR /usr/local/src/kfp/components

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install dependencies into the base image's default Python (/opt/app-root/bin/python)
COPY ${COMPONENT_NAME}/requirements.txt component-requirements.txt
USER root
RUN uv pip install -r component-requirements.txt --python /opt/app-root/bin/python

# Copy component source and shared
COPY ${COMPONENT_NAME}/src/ .
COPY shared ./shared

